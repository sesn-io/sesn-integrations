<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.sesn" name="Sesn Repository" version="1.0.1" provider-name="Sesn">
  <extension point="xbmc.addon.repository" name="Sesn Repository">
    <!-- Served from the protected kodi-repo branch, written only by kodi/tools/release.py.
         Kodi 18+ checks addons.xml against addons.xml.sha256 and each zip against
         its <zip>.sha256 before installing. -->
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/sesn-io/sesn-integrations/kodi-repo/addons.xml</info>
      <checksum verify="sha256">https://raw.githubusercontent.com/sesn-io/sesn-integrations/kodi-repo/addons.xml.sha256</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/sesn-io/sesn-integrations/kodi-repo</datadir>
      <hashes>sha256</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Install and auto-update the Sesn add-on for Kodi</summary>
    <description lang="en_GB">Adds the Sesn repository so Kodi can install and keep the Sesn add-on (script.sesn) up to date automatically. Sesn is a simple, private TV, film and anime tracker — sesn.io.</description>
    <platform>all</platform>
    <license>MIT</license>
    <source>https://github.com/sesn-io/sesn-integrations</source>
    <website>https://sesn.io/kodi</website>
    <assets>
      <icon>icon.png</icon>
    </assets>
    <news>1.0.1 - Add-ons now come from a dedicated, protected release branch, and Kodi verifies a SHA-256 checksum for the index and every download.</news>
  </extension>
</addon>
