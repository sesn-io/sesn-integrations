<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- settings.xml v2 schema (Kodi 19+). -->
<settings version="1">
  <section id="script.sesn">
    <category id="account" label="30001"><!-- Account -->
      <group id="1">
        <!-- Pair (shown only when NOT connected): a short code to confirm at sesn.io/link. -->
        <setting id="pair" type="action" label="30012">
          <level>0</level>
          <data>RunPlugin(plugin://script.sesn/?action=pair)</data>
          <control type="button" format="action">
            <close>true</close>
          </control>
          <dependencies>
            <dependency type="visible">
              <condition setting="api_key" operator="is"></condition>
            </dependency>
          </dependencies>
        </setting>
        <!-- Connected status + Disconnect (shown only WHEN connected). Its presence
             is the "✓ connected" indicator; tapping it forgets the key on this box. -->
        <setting id="disconnect" type="action" label="30013">
          <level>0</level>
          <data>RunPlugin(plugin://script.sesn/?action=disconnect)</data>
          <control type="button" format="action">
            <close>true</close>
          </control>
          <dependencies>
            <dependency type="visible">
              <condition setting="api_key" operator="!is"></condition>
            </dependency>
          </dependencies>
        </setting>
      </group>
    </category>
    <category id="scrobbling" label="30002"><!-- Scrobbling -->
      <group id="1">
        <setting id="scrobble_movies" type="boolean" label="30020">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="scrobble_episodes" type="boolean" label="30021">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="notify" type="boolean" label="30022">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <!-- Live TV is never scrobbled; not exposed as a toggle. -->
      </group>
    </category>
    <category id="sync" label="30050"><!-- Two-way sync -->
      <group id="1">
        <!-- Writes to your Kodi library — off by default. -->
        <setting id="sync_down" type="boolean" label="30051">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>
    <category id="advanced" label="30003"><!-- Advanced -->
      <group id="1">
        <!-- Manual key entry — the fallback for anyone who can't pair (headless,
             scripted). Pairing writes here automatically, and the addon reads it;
             it lives under Advanced so the main tab is just "Pair this device".
             ⚠ allowempty IS REQUIRED on an empty-default string or the field fails
             to load and vanishes from the dialog. -->
        <setting id="api_key" type="string" label="30010">
          <level>0</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30010</heading>
          </control>
        </setting>
        <setting id="server_url" type="string" label="30011">
          <level>2</level>
          <default>https://sesn.io</default>
          <control type="edit" format="string">
            <heading>30011</heading>
          </control>
        </setting>
        <setting id="debug" type="boolean" label="30030">
          <level>2</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>
  </section>
</settings>
